---
/**
 * メインページ
 * 
 * 小説リストを表示するメインビュー
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.svelte';
import ServerStoppedBanner from '../components/ServerStoppedBanner.svelte';
import NovelList from '../components/NovelList.svelte';
import ConsolePanel from '../components/ConsolePanel.svelte';
import Footer from '../components/Footer.svelte';
---

<BaseLayout title="Narou.rb MOD - ホーム">
  <div class="min-h-screen flex flex-col">
    <Header client:load />
    <ServerStoppedBanner client:load />
    <main class="flex-1 relative">
      <NovelList client:load />
    </main>
    <ConsolePanel client:only="svelte" />
    <Footer client:load />
  </div>
</BaseLayout>

