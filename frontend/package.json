{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node -e \"require('fs').writeFileSync('dist/.build-commit', require('child_process').execSync('git describe --always').toString().trim())\"",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{ts,js,svelte,astro,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,svelte,astro,css,json}\"",
    "prepare": "cd .. && husky frontend/.husky || true"
  },
  "lint-staged": {
    "*.{ts,js,svelte,astro,css,json}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/svelte": "^7.2.5",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^5.17.3",
    "svelte": "^5.53.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.0"
  },
  "overrides": {
    "yaml": "^2.8.3"
  }
}
