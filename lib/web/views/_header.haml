:ruby
  enable_save_settings ||= false
  nav ||= ''
  bootsnap_on = !!$bootsnap_enable

.navbar.navbar-default.navbar-fixed-top(role="navigation")
  .container
    .navbar-header
      %button.navbar-toggle(type="button")
        %span.sr-only Toggle navigation
        %span.icon-bar
        %span.icon-bar
        %span.icon-bar
      %a.navbar-brand(href="#" data-move-to="top")
        Narou.rb
        %span#bootsnap-indicator.zap{
          class: (bootsnap_on ? 'on glow' : 'off'),
          title: (bootsnap_on ? 'Bootsnap!' : 'Normal'),
          'data-toggle' => 'tooltip',
          'data-placement' => 'bottom',
          role: 'img',
          'aria-label' => (bootsnap_on ? 'Bootsnap enabled' : 'Bootsnap disabled')
        } ⚡︎
        MOD WEB UI
    .collapse.navbar-collapse
      %ul.nav.navbar-nav
        %li{ class: ("active" if nav == "settings") }
          %a(href="/settings") 環境設定
        %li{ class: ("active" if nav == "help") }
          %a(href="/help") ヘルプ
        %li
          %a(href="/") 戻る
      - if enable_save_settings
        .navbar-form.navbar-left
          %input.btn.btn-info(type="submit" value="設定を保存" style="margin-left: 50px")
          %button#btn-reboot.btn.btn-default サーバを再起動
      = partial :queue

:css
  /* 絵文字じゃなくテキスト表示の⚡︎（U+FE0E）を使っているので color が効きやすい */
  .zap {
    font-size: 1.1em;
    line-height: 1;
    vertical-align: middle;
    margin-right: 6px;
  }

  .zap.on  { color: #f5c518; }   /* 黄色っぽい */
  .zap.off { color: #9aa0a6; opacity: .85; } /* グレー */

  .zap.on.glow {
    /* 常時ふわっと光る */
    text-shadow:
      0 0 2px currentColor,
      0 0 6px currentColor,
      0 0 10px rgba(245,197,24,.6);
    animation: zapGlow 2s ease-in-out infinite;
  }

  /* ホバー時は少し強めに発光 */
  .zap.on.glow:hover {
    animation-duration: 1.2s;
    text-shadow:
      0 0 3px currentColor,
      0 0 10px currentColor,
      0 0 16px rgba(245,197,24,.9);
  }

  /* OFF でもホバーで薄いハイライトにするなら（任意） */
  .zap.off:hover {
    text-shadow: 0 0 2px rgba(154,160,166,.6);
  }

  /* 低速環境／好み配慮 */
  @media (prefers-reduced-motion: reduce) {
    .zap.on.glow { animation: none; }
  }

  @keyframes zapGlow {
    0%, 100% {
      filter: brightness(1);
      opacity: 1;
    }
    50% {
      filter: brightness(1.25);
      opacity: .95;
    }
  }

:javascript
  $(function () {
    $('[data-toggle="tooltip"]').tooltip();
  });
