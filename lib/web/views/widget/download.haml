!!! 5
%html{:lang => "ja"}
  %head
    %meta{:charset => "utf-8"}/
    %meta{:content => "IE=edge", "http-equiv" => "X-UA-Compatible"}/
    %meta{:content => "width=device-width, initial-scale=1", :name => "viewport"}/
    %meta{:content => "whiteleaf", :name => "author"}/
    %meta{:content => "none", :name => "robots"}/
    %title Narou.rb MOD WEB UI Widget
    %link{:href => "//cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css", :rel => "stylesheet"}/
    %link{:href => "//cdn.jsdelivr.net/npm/perfect-scrollbar@1.5.6/css/perfect-scrollbar.min.css", :rel => "stylesheet"}/
    %link{:href => "/style.css?_=#{Narou::VERSION}.#{Narou::COMMIT}", :rel => "stylesheet"}/
    %link{:href => "/resources/css/default-style.css?_=#{Narou::VERSION}.#{Narou::COMMIT}", :rel => "stylesheet"}/
  %body
    :css
      html, body, .console.fullscreen {
        height: 100%;
        margin: 0;
        padding: 0;
      }
      .queue {
        position: absolute;
        top: 3px;
        right: 3px;
        color: white;
        margin: 0;
        padding: 0;
      }

    = embed_concurrency_enabled

    #console.console.fullscreen
    .queue.navbar-text.navbar-right
      %span.glyphicon.glyphicon-inbox
      %span.queue__sizes
        %span.queue__size.queue__size--default> 0
        - if Narou.concurrency_enabled?
          %span.queue__size.queue__size--divider
          %span.queue__size.queue__size--convert> 0

    %script{:src => "//cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"}
    %script{:src => "//cdn.jsdelivr.net/npm/jquery-migrate@3.5.2/dist/jquery-migrate.js"}
    %script{:src => "//cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js"}
    %script{:src => "//cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js"}
    %script{:src => "/resources/js/sprintf.js?_=#{Narou::VERSION}.#{Narou::COMMIT}"}
    %script{:src => "//cdn.jsdelivr.net/npm/perfect-scrollbar@0.8.1/dist/js/perfect-scrollbar.jquery.min.js"}
    %script{:src => "/resources/js/narou.library.js?_=#{Narou::VERSION}.#{Narou::COMMIT}"}
    %script{:src => "/resources/js/narou.queue.js?_=#{Narou::VERSION}.#{Narou::COMMIT}"}
    :javascript
      $(document).ready(function($) {
        var stream_console = new Narou.Console({
          restore: false, buttons: false
        });
      });


