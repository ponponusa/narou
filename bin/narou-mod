#! /usr/bin/env ruby
# -*- mode: ruby -*-
# -*- coding: utf-8 -*-
#
# Narou.rb ― 小説家になろうダウンロード＆整形スクリプト
#
# Copyright 2013 whiteleaf. All rights reserved.
#

# YJIT bootstrap (enable only when supported; never warn on unsupported)
begin
  require 'rbconfig'
  host_os = RbConfig::CONFIG['host_os']
  on_windows = !!(host_os =~ /mswin|mingw|cygwin/)

  # 一応 NAROU_YJIT=0 の指定で明示的にオフにもできるように
  want_yjit = ENV.fetch('NAROU_YJIT', '1') == '1'

  if want_yjit && !on_windows && defined?(RubyVM::YJIT)
    # Ruby 3.2+ 想定
    if RubyVM::YJIT.respond_to?(:enabled?) && RubyVM::YJIT.respond_to?(:enable)
      RubyVM::YJIT.enable unless RubyVM::YJIT.enabled?
    end
  end
rescue => _e
  # 何もしない（対応外/古いRubyでも静かにスルー）
end

begin
  # narou-modコマンド前に下記のように環境変数を定義すればbootsnapは無効にする
  # > set NAROU_NO_BOOTSNAP=1
  unless ENV["NAROU_NO_BOOTSNAP"] == "1"
    # 念のためWindows系のプラットフォームではないことを確認しておく
    is_windows = Gem.win_platform? rescue (/mswin|mingw|cygwin|bccwin|wince|emx/ =~ RUBY_PLATFORM)
    unless is_windows
      require "bootsnap"
      Bootsnap.setup(
        cache_dir: 'tmp/bootsnap-cache',
        development_mode: false,
        load_path_cache: true,
        compile_cache_iseq: true,
        compile_cache_yaml: true
      )
    end
  end
rescue Exception => e
  warn "[narou-mod] Bootsnap disabled (#{e.class}: #{e.message})" if ENV["NAROU_BOOTSNAP_DEBUG"] == "1"
end
$bootsnap_enable = defined?(Bootsnap)

if File.exist?("narou.rb")
  require File.join(Dir.pwd, "narou.rb")
else
  require_relative "../narou.rb"
end
