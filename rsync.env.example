# rsync 同期設定ファイル
#
# このファイルは sync-to-windows.sh スクリプトで使用されます。
# コマンドライン引数が指定されていない場合、この設定が使用されます。
#
# 使い方:
#   1. このファイルを rsync.env としてコピー
#   2. 同期元・同期先のパスを編集
#   3. ./sync-to-windows.sh を実行
#
# 注意:
#   - パスに ~ を使用可能 (例: ~/git/narou-mod)
#   - 環境変数を使用可能 (例: $HOME/git/narou-mod)
#   - 引用符で囲むことを推奨

# 同期元ディレクトリ (WSL環境)
SRC_DIR="$HOME/git/narou-mod"

# 同期先ディレクトリ (Windows環境)
# 例: /mnt/c/git/narou → C:\git\narou
DEST_DIR="/mnt/c/git/narou-mod"
